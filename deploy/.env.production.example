# Copy to deploy/production.env (chmod 600) and fill every placeholder.
# Generate the four JSON fields with:
#   uv run --locked python scripts/build_live_config.py \
#     --spec private/live-spec.json --output-dir private/generated
# then paste the OIL_*_PERMISSION / OIL_APPROVED_RULES_JSON lines from
# private/generated/env.generated below. Never commit this file.

OIL_ENVIRONMENT=production
OIL_DATABASE_URL=postgresql+psycopg://oil_prod:REPLACE_DB_PASSWORD@postgres:5432/oil_prod
OIL_DATA_PROVENANCE=production
OIL_FIXTURE_DATASET=null
OIL_OUTBOUND_MODE=production
OIL_FIRST_REPORT_POLICY=credible_single_source
OIL_PUBLIC_ORIGIN=https://oil-agent.internal
OIL_COOKIE_SECURE=true

OIL_EXTERNAL_SOURCES_ENABLED=true
OIL_MODEL_CALLS_ENABLED=true
OIL_IDENTITY_ENABLED=true
OIL_DAILY_SOURCE_REQUESTS=200
OIL_DAILY_MODEL_CALLS=50
OIL_DAILY_MODEL_TOKENS=200000

# Provider credentials: inject only here, never in Git or chat.
OIL_EIA_API_KEY=REPLACE
OIL_EIA_SERIES_ID=PET.RWTC.D
OIL_EIA_PRODUCT=WTI
OIL_EIA_UNIT=USD/BBL
OIL_EIA_POLL_SECONDS=86400
OIL_GNEWS_API_KEY=REPLACE
OIL_GNEWS_QUERY=refinery OR OPEC OR "strait of hormuz" OR "oil supply"
OIL_GNEWS_LANG=en
OIL_GNEWS_MAX_ITEMS=10
OIL_GNEWS_POLL_SECONDS=1800
OIL_DEEPSEEK_API_KEY=REPLACE
OIL_FEISHU_APP_SECRET=REPLACE
OIL_FEISHU_REDIRECT_URI=https://oil-agent.internal/oauth/callback

# Optional explicit public IP pins (comma-free JSON). Leave empty on a clean
# cloud network; use it only when local DNS answers are not public.
# OIL_SOURCE_IP_PINS={"api.eia.gov":["3.32.1.168"],"gnews.io":["157.230.179.93"]}

OIL_PRODUCTION_SOURCE_LICENSE_REF=op:eia-gnews-public
OIL_PRODUCTION_RECIPIENT_APPROVAL_REF=op:recipients-2026-10
OIL_PRODUCTION_BUDGET_UNITS=100000
OIL_PRODUCTION_RETENTION_DAYS=90
OIL_PRODUCTION_CREDENTIALS_REF=project:oil-agent-prod
OIL_PRODUCTION_IDENTITY_VERIFICATION_REF=op:feishu-tenant-verified

# Paste generated JSON (single line each):
# OIL_SOURCE_PERMISSIONS=[...]
# OIL_MODEL_PERMISSION={...}
# OIL_IDENTITY_PERMISSION={...}
# OIL_APPROVED_RULES_JSON={...}
