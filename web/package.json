{
  "name": "oil-agent-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "generate": "node scripts/generate-types.mjs",
    "generate:check": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src scripts *.json *.ts *.html *.md",
    "browser:check": "node scripts/browser-check.mjs",
    "test": "vitest run --maxWorkers=1",
    "build": "npm run generate:check && npm run typecheck && vite build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
