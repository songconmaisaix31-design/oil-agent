# No dotenv file is loaded automatically. Inject OIL_* settings explicitly.
# DATABASE_URL must use postgresql+psycopg://; no credentials are supplied here.
# OIL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:PORT/DATABASE
OIL_ENVIRONMENT=development
OIL_OUTBOUND_MODE=dry_run
OIL_REMINDERS_ENABLED=false
OIL_SMS_ENABLED=false
OIL_PHONE_ENABLED=false
# OIL_FIRST_REPORT_POLICY is deliberately unset.
