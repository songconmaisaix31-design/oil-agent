# No dotenv file is loaded automatically. Inject OIL_* settings explicitly.
# DATABASE_URL must use postgresql+psycopg://; no credentials are supplied here.
# OIL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:PORT/DATABASE
OIL_ENVIRONMENT=development
OIL_DATA_PROVENANCE=fixture
OIL_OUTBOUND_MODE=dry_run
OIL_REMINDERS_ENABLED=false
OIL_SMS_ENABLED=false
OIL_PHONE_ENABLED=false
# OIL_FIRST_REPORT_POLICY is deliberately unset.
OIL_PUBLIC_ORIGIN=https://localhost
OIL_COOKIE_SECURE=true
OIL_SESSION_TTL_SECONDS=3600
OIL_IDENTITY_ENABLED=false
OIL_EXTERNAL_SOURCES_ENABLED=false
OIL_MODEL_CALLS_ENABLED=false
OIL_DAILY_SOURCE_REQUESTS=1000
OIL_DAILY_PROCESSING_CALLS=1000
OIL_URGENT_PROCESSING_RESERVE=200
OIL_DAILY_MODEL_CALLS=0
OIL_DAILY_MODEL_TOKENS=0
OIL_URGENT_MODEL_RESERVE=0
OIL_URGENT_MODEL_TOKEN_RESERVE=0
OIL_FIXTURE_DATASET=local-v01
# Shared safe default for API and all workers; no sources or data are seeded.
OIL_RUNTIME_FACTORY=oil_agent.bootstrap:build_runtime
# Trial assembly uses the same dispatcher or oil_agent.bootstrap:build_trial_runtime.
# Set C's explicit provenance/permissions before injecting any provider secrets.
# Nonfixture startup requires OIL_DATA_PROVENANCE=trial and OIL_FIXTURE_DATASET=null.
# Production assembly is unavailable; trial inputs do not establish production acceptance.
# Jin10 provider must be jin10; OIL_SOURCE_PERMISSIONS contains C permission JSON.
# Project-only secret injection: OIL_JIN10_TOKEN (never print or store in this file).
# OIL_JIN10_ARGUMENTS_JSON must be explicitly supplied, even when reviewed as {}.
# Optional discovered cursor binding: OIL_JIN10_OFFSET_PARAMETER / OIL_JIN10_OFFSET_TYPE.
# OIL_MODEL_PERMISSION is C's exact provider=openai/model/request/token/rules approval.
# Model secret: OIL_OPENAI_API_KEY; no model name, rule or budget is supplied by default.
# OIL_APPROVED_RULES_JSON contains AB ApprovedRules, supplied explicitly and bounded to 64KB.
# Both model/send rules_ref must equal authorization_ref@version from those loaded rules;
# @ is forbidden in each component, and permission validity must fit rule validity.
# Feishu app/tenant/approved identities come from OIL_IDENTITY_PERMISSION JSON.
# OIL_FEISHU_REDIRECT_URI is the exact registered HTTPS web return URL.
# Identity secret: OIL_FEISHU_APP_SECRET; trial messages additionally require
# OIL_FEISHU_ENCRYPT_KEY and OIL_FEISHU_VERIFICATION_TOKEN through process injection.
# OIL_TRIAL_SEND_PERMISSION is C's exact expiring test-recipient/rule/budget approval.
# No credentials_ref is interpreted as an arbitrary environment or file lookup.
# Real local quote uploads need matching OIL_QUOTE_UPLOAD_RIGHTS_REF and
# OIL_QUOTE_ORIGIN_PUBLISHER; no customer data or upload authorization is provided.
# No recipients/roles are provisioned by default and no identity provider is installed.
# Business policy/channel/recipients/reminders live in audited database config.
# The environment reminder toggle remains false; the API snapshots revision settings.
# Production references/budget/retention are deliberately absent and are not acceptance proof.
